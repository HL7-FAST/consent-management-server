uctureDefinition/resource-information","valueString":"Requirements"}],"reference":{"reference":"Requirements/conformance-client"},"name":"Conformance Client","description":"Conformance Requirements for Client","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Requirements"}],"reference":{"reference":"Requirements/conformance-client-consent-server"},"name":"Conformance Client Admin Service","description":"Conformance Requirements for Client Admin Service","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CapabilityStatement"}],"reference":{"reference":"CapabilityStatement/ConsentClientCapabilities"},"name":"Consent Client Capabilities","description":"Capabilities required for a Consent Client system filing and reviewing consents.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/client"},"name":"Consent Client System","description":"A system responsible for gathering patient consent decisions and filing them with a consent administration service. Typically implemented as an EHR system, patient portal, or similar application. Corresponds to the IHE-PCF Consent Recorder actor.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CapabilityStatement"}],"reference":{"reference":"CapabilityStatement/ConsentAdministrativeServerCapabilities"},"name":"Consent Server Capabilities","description":"Capabilities required for a Consent Server system (consent administration service) receiving and managing consents.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/consent-server"},"name":"Consent Server System","description":"A consent server system is responsible for storing consent records and servicing requests for consent data. Implements the File Consent and Revoke Consent operations, supports consent search and subscriptions, and maintains audit events for consent access decisions. Corresponds to the IHE-PCF Consent Registry actor.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"AuditEvent"}],"reference":{"reference":"AuditEvent/ConsentAuditEventExample"},"name":"ConsentAuditEventExample","description":"An example of a Consent Audit Event","exampleCanonical":"http://hl7.org/fhir/us/consent-management/StructureDefinition/FASTConsentAuditEvent"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Consent"}],"reference":{"reference":"Consent/ConsentExample"},"name":"ConsentExample","description":"An example of a consent.","exampleCanonical":"http://hl7.org/fhir/us/consent-management/StructureDefinition/FASTConsent"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"DocumentReference"}],"reference":{"reference":"DocumentReference/DocumentReferenceExample"},"name":"DocumentReferenceExample","description":"An example of a consent document.","exampleCanonical":"http://hl7.org/fhir/us/consent-management/StructureDefinition/FASTDocumentReference"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Requirements"}],"reference":{"reference":"Requirements/extended-operations-client-consent-server"},"name":"Extended Operations Client Admin Service","description":"Extended Operations Requirements for Client Admin Service","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/FASTConsentStatuses"},"name":"FAST Consent Statuses","description":"The two codes that are applicable to FAST Consent instances.  'active' for active Consents, and 'inactive' for revoked Consents.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"SubscriptionTopic"}],"reference":{"reference":"SubscriptionTopic/FASTConsentSubscriptionTopic"},"name":"FAST Consent Subscription Topic","description":"This is the subscription topic used for ensuring Consent records are updated amongst a set of Consent Registries.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"SearchParameter"}],"reference":{"reference":"SearchParameter/fast-consent-controller"},"name":"fast-consent-controller","description":"The Consent controller reference which is defined by the Consent extension controller.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"SearchParameter"}],"reference":{"reference":"SearchParameter/fast-consent-manager"},"name":"fast-consent-manager","description":"The Consent manager reference which is defined by the Consent extension manager.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/FASTConsent"},"name":"FASTConsent","description":"This profile captures the details of a Patient's Consent.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/FASTConsentAuditEvent"},"name":"FASTConsentAuditEvent","description":"Disclosures are recorded as FHIR AuditEvent instances.  These AuditEvents reflect the Consent instance that was consulted and whether the decision to disclose data was made or not.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/FASTDocumentReference"},"name":"FASTDocumentReference","description":"This profile records non-structured documentation that records a patient's consent.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Subscription"}],"reference":{"reference":"Subscription/FASTOrganizationSubscriptionExample"},"name":"FASTOrganizationSubscriptionExample","description":"An example of a FAST Subscription for a specific organization (controller).","exampleCanonical":"http://hl7.org/fhir/us/consent-management/StructureDefinition/FASTSubscription"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Subscription"}],"reference":{"reference":"Subscription/FASTPatientSubscriptionExample"},"name":"FASTPatientSubscriptionExample","description":"An example of a FAST Subscription for a specific patient.","exampleCanonical":"http://hl7.org/fhir/us/consent-management/StructureDefinition/FASTSubscription"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:complex-type"}],"reference":{"reference":"StructureDefinition/FASTReference"},"name":"FASTReference","description":"A profile on the Reference datatype that requires the identifier and exposes a set of additional identifiers in an extension.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:resource"}],"reference":{"reference":"StructureDefinition/FASTSubscription"},"name":"FASTSubscription","description":"A profile for FAST subscriptions.","exampleBoolean":false},{"extension":[{"url":"htt