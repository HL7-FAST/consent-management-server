ructureDefinition/extension-Requirements.statement.conformance","valueCode":"MAY"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service MAY return OperationOutcome for a successful operation<br/><br/>I believe they are referring only to extended operations defined by the IG."},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=Consent%20Server%20systems%20MAY%20return%20an%20OperationOutcome%20with%20a%20success%20when%20they%20wish%20to%20provide%20additional%20structured%20information%20alongside%20a%20successful%20operation%20response"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"68"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-68"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHOULD"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHOULD return OperationOutcome with details of which business rules did not allow an operation to be successful if an HTTP status code of 4xx or 5xx is returned<br/><br/>I believe they are referring only to extended operations defined by the IG."},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=Systems%20SHOULD%20return%20an%20OperationOutcome%20with%20the%20details%20if%20an%20HTTP%20status%20code%20of%204xx%20or%205xx%20is%20returned"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"62"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-62"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL support File Consent operation<br/><br/>Redundant with CapStmt"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=are%20defined%20that-,a%20consent%20administration%20service%20SHALL%20support%3A,-File%20Consent&text=service%20SHALL%20support%3A-,File%20Consent,-and%20Revoke%20Consent"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"101"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-101"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL support Revoke Consent operation<br/><br/>Redundant with CapStmt"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=are%20defined%20that-,a%20consent%20administration%20service%20SHALL%20support%3A,-File%20Consent&text=File%20Consent%20and-,Revoke%20Consent,-.%20%C2%A7OP1"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"63"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-63"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL support Consent search"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=consent%20administration%20service%20systems%20SHALL%20support%20searching%20for%20consents"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"64"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-64"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL support Consent subscriptions (as defined by the FAST Subscription Topic for FHIR R4 with Subscriptions Backport)<br/><br/>Fix: \"a consent administration service SHALL support subscriptions to allow other systems to be informed when consents for a patient have changed.\" - this should be more precise, like \"a consent administration service SHALL support subscriptions as defined by the FAST Subscription Topic, e.g. to allow other systems to be informed when consents for a patient have changed.\""},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=consent%20administration%20service%20SHALL%20support%20subscriptions%20to%20allow%20other%20systems%20to%20be%20informed%20when%20consents%20for%20a%20patient%20have%20changed"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"727"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-727"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL set Consent status element to 'active' when a File Consent operation has succeeded."},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=When%20filing%20a%20consent%2C%20the%20Consent%20status%20element%20SHALL%20be%20set%20to%20%27active%27"}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"634"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-634"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement","valueMarkdown":"Consent Administration Service SHALL set Consent status element to 'inactive' when a Revoke Consent operation has succeeded."},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom","valueString":"HL7 FAST Consent IG"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy","valueUrl":"https://build.fhir.org/ig/HL7/fhir-consent-management/en/technical.html#:~:text=After%20a%20consent%20has%20been%20revoked%2C%20the%20Consent%20status%20element%20for%20the%20revoked%20consent%20SHALL%20be%20set%20to%20%27inactive%27."}],"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement"},{"extension":[{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key","valueId":"760"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label","valueString":"requirement-760"},{"url":"http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance","valueCode":"SHALL"},{"url":"http://hl7.org/fhir/5.0/StructureDefi